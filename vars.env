export E4S_VERSION=26.11

## S3 Settings
S3_BUCKET=${S3_BUCKET:-cache.e4s.io}
S3_PREFIX=${S3_PREFIX:-e4s-${E4S_VERSION}}
S3_ENDPOINT=${S3_ENDPOINT:-https://uo-spack-mirror.e4s.io:9002}

## Spack settings
spack_core_checkout=8d1b485913f4eb227042f7c47d2f04421ece7308
spack_core_repo=https://github.com/spack/spack
spack_core_root=/spack
spack_packages_checkout=3e9980e0e7058858554960db8c065185757090d4
spack_packages_repo=https://github.com/spack/spack-packages
spack_packages_root=/spack-packages
spack_mirror=s3://${S3_BUCKET}/${S3_PREFIX}
