## S3 Settings
s3_bucket=${S3_BUCKET:-cache.e4s.io}
s3_endpoint=${S3_ENDPOINT:-https://uo-spack-mirror.e4s.io:9002}

## Spack settings
spack_core_checkout=v1.2.2
spack_core_repo=https://github.com/spack/spack
spack_core_root=/spack
